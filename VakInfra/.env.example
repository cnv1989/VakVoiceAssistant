# Read by `./vak deploy` (from the repo root) and merged into `cdk deploy`'s
# CDK context. All of these are optional — see README.md's context table for
# the full list and what each one does. Generated automatically by
# `./vak init` if you opt into the AWS section; safe to edit by hand too.

AWS_REGION=us-west-2

# Forwarded to the container — see VakDeepGram/providers/common/persona.py
# BUSINESS_NAME=
# BUSINESS_VERTICAL=generic

# Custom domain (requires an existing Route 53 hosted zone for HOSTED_ZONE_DOMAIN)
# DOMAIN_NAME=voice.example.com
# HOSTED_ZONE_DOMAIN=example.com

# WAF: require an X-Api-Key header on every request except /health
# API_KEY=

# Restrict the ALB to Twilio's published Media Streams IP ranges
# ENABLE_TWILIO_ONLY_ACCESS=false
