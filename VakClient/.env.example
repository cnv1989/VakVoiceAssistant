# WebSocket URL for local development
# Default: ws://localhost:8080/ws
# VITE_WS_URL=ws://localhost:8080/ws

# For production/ALB, use:
# Get ALB DNS from CDK stack output: VakAlbDns
# VITE_WS_URL=ws://ALB_DNS/ws
# Example:
# VITE_WS_URL=ws://VakApp-VakAl-S9TUK4zMiO73-829936755.us-west-2.elb.amazonaws.com/ws
