# Business branding (shown in the header and chat page)
# VITE_BUSINESS_NAME=Vak Assistant

# WebSocket URL for the voice page (local dev default shown below)
# VITE_WS_URL=ws://localhost:8080/ws
#
# For a deployed backend, use the WebSocketUrl output from `cdk deploy`
# (see VakInfra/README.md), e.g.:
# VITE_WS_URL=wss://voice.example.com/ws

# REST endpoint for the chat page's "Deployed" option (optional — the
# "Local" option always uses http://localhost:8080/chat)
# VITE_CHAT_API_URL=https://voice.example.com/chat
