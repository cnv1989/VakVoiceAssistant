# Business Profile
# Shapes the agent's persona (see providers/common/persona.py for the full list
# and docs/CUSTOMIZING_YOUR_AGENT.md for a walkthrough of adding your own).
# BUSINESS_VERTICAL options: generic, barber, salon, spa, medical, fitness, home_services
BUSINESS_NAME=
BUSINESS_VERTICAL=generic
# Optional: fully replace the generated "#Role" sentence instead of using a vertical preset
# BUSINESS_ROLE_DESCRIPTION=a friendly front-desk assistant for an auto repair shop.

# LLM Provider — powers the /chat endpoint and voice function-calling (Strands Agent)
# Options: bedrock (default, needs AWS credentials, no API key here),
#          anthropic (direct Anthropic API), openai (direct OpenAI API)
LLM_PROVIDER=bedrock
# LLM_MODEL_ID=                    # Optional override; each provider has a sensible default
# ANTHROPIC_API_KEY=               # Required if LLM_PROVIDER=anthropic
# OPENAI_API_KEY=                  # Required if LLM_PROVIDER=openai

# Deepgram Configuration
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8080
# debug, info, warning, error
LOG_LEVEL=info

# Optional: Deepgram Agent Configuration
DEEPGRAM_AGENT_LANGUAGE=en
DEEPGRAM_LISTENING_MODEL=flux-general-en
DEEPGRAM_LISTENING_VERSION=v2
# LLM bridge inside the Deepgram Voice Agent itself (separate from LLM_PROVIDER
# above). Accepts any provider type Deepgram's Voice Agent API supports:
# open_ai, anthropic, google, amazon_bedrock, and others as Deepgram adds them.
DEEPGRAM_THINKING_PROVIDER=google
DEEPGRAM_THINKING_MODEL=gemini-2.0-flash

# Speaking/TTS Configuration
# "eleven_labs" and "deepgram" (Aura) are first-class below; any other value
# Deepgram's Voice Agent API supports (e.g. "cartesia") is passed through
# generically using the *_MODEL_ID / *_MODEL / *_VOICE_ID fields.
DEEPGRAM_SPEAKING_PROVIDER=eleven_labs
# For ElevenLabs:
DEEPGRAM_SPEAKING_MODEL_ID=eleven_multilingual_v2
DEEPGRAM_SPEAKING_VOICE_ID=cgSgspJ2msm6clMCkdW9
# For Deepgram TTS (if DEEPGRAM_SPEAKING_PROVIDER=deepgram):
# DEEPGRAM_SPEAKING_MODEL=aura-2-odysseus-en

DEEPGRAM_INPUT_SAMPLE_RATE=48000
DEEPGRAM_OUTPUT_SAMPLE_RATE=24000

# Optional: Custom fallback greeting used until business context resolves a name
# DEEPGRAM_AGENT_GREETING=Hello! How may I help you?

# Optional: Bedrock AgentCore Memory for chat session storage (replaces file-based sessions)
# Create a memory in AWS Bedrock AgentCore, then set:
# AGENTCORE_MEMORY_ID=your-memory-id
# AGENTCORE_ACTOR_ID=vak-chat-agent

# Optional: OAuth (for fronting Vak with your own authenticated business dashboard)
# OAuth bearer tokens are validated against JWKS for /voice/oauth/connect and /chat/oauth.
# Replace <region>, <pool-id> and the client IDs with your own Cognito user pool's.
# OAUTH_JWKS_URL=https://cognito-idp.<region>.amazonaws.com/<pool-id>/.well-known/jwks.json
# OAUTH_ISSUER=https://cognito-idp.<region>.amazonaws.com/<pool-id>
# OAUTH_AUDIENCE=<app-client-id>[,<second-app-client-id>]
# OAUTH_REQUIRED_SCOPE=vak.voice.connect
# OAUTH_ALLOW_LOCALHOST_NOAUTH=true

# Optional: Twilio (voice + SMS) — run `./vak twilio` to connect a number.
# See ../docs/TWILIO.md for the security model.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_BUSINESS_NUMBER=+15551234567   # the Twilio number callers dial
# TWILIO_FROM_NUMBER=+15551234567       # outbound SMS sender (defaults to the above)
# For A2P SMS campaign setup script: scripts/setup_twilio_sms_campaign.py
