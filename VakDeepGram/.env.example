# Business Profile
# Shapes the agent's persona (see providers/common/persona.py for the full list
# and docs/CUSTOMIZING_YOUR_AGENT.md for a walkthrough of adding your own).
# BUSINESS_VERTICAL options: generic, barber, salon, spa, medical, fitness, home_services
BUSINESS_NAME=
BUSINESS_VERTICAL=generic
# Optional: fully replace the generated "#Role" sentence instead of using a vertical preset
# BUSINESS_ROLE_DESCRIPTION=a friendly front-desk assistant for an auto repair shop.

# Deepgram Configuration
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_PROJECT_ID=your_project_id_here
# Optional: Leave empty to create agent dynamically, or provide existing agent ID
DEEPGRAM_AGENT_ID=

# Server Configuration
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=debug

# Optional: Deepgram Agent Configuration
DEEPGRAM_AGENT_LANGUAGE=en
DEEPGRAM_LISTENING_MODEL=flux-general-en
DEEPGRAM_LISTENING_VERSION=v2
DEEPGRAM_THINKING_PROVIDER=google
DEEPGRAM_THINKING_MODEL=gemini-2.5-flash

# Speaking/TTS Configuration
# Set to "eleven_labs" to use ElevenLabs, "deepgram" for Deepgram TTS
DEEPGRAM_SPEAKING_PROVIDER=eleven_labs
# For ElevenLabs:
DEEPGRAM_SPEAKING_MODEL_ID=eleven_multilingual_v2
DEEPGRAM_SPEAKING_VOICE_ID=cgSgspJ2msm6clMCkdW9
# For Deepgram TTS (if DEEPGRAM_SPEAKING_PROVIDER=deepgram):
# DEEPGRAM_SPEAKING_MODEL=aura-2-odysseus-en

DEEPGRAM_INPUT_SAMPLE_RATE=48000
DEEPGRAM_OUTPUT_SAMPLE_RATE=24000

# Optional: Custom fallback greeting used until business context resolves a name
# DEEPGRAM_AGENT_GREETING=Hello! How may I help you?

# Optional: Bedrock AgentCore Memory for chat session storage (replaces file-based sessions)
# Create a memory in AWS Bedrock AgentCore, then set:
# AGENTCORE_MEMORY_ID=your-memory-id
# AGENTCORE_ACTOR_ID=vak-chat-agent

# Optional: OAuth (Integrin app)
# OAuth bearer tokens are validated against JWKS for /voice/oauth/connect and /chat/oauth
# OAUTH_JWKS_URL=https://cognito-idp.us-west-2.amazonaws.com/us-west-2_9T0qoUbEe/.well-known/jwks.json
# OAUTH_ISSUER=https://cognito-idp.us-west-2.amazonaws.com/us-west-2_9T0qoUbEe
# OAUTH_AUDIENCE=5ur84i37eq9u4h9v46tb40s5cc,6mlpas326rc65o19q7mhj7bqq8
# OAUTH_REQUIRED_SCOPE=vak.voice.connect
# OAUTH_ALLOW_LOCALHOST_NOAUTH=true

# Optional: Twilio (voice + SMS)
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+15109014392  # alpha/local sandbox: +15109014392, beta: +15106942495, prod: +15104054454
# For A2P SMS campaign setup script: scripts/setup_twilio_sms_campaign.py
