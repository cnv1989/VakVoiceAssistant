# Local development mode (set to 'true' to enable WebSocket server)
LOCAL_MODE=true

# AWS Region
REGION=us-west-2

# API Gateway WebSocket endpoint (leave empty for local mode)
# Format: https://{api-id}.execute-api.{region}.amazonaws.com/{stage}
WS_API_ENDPOINT=

# Bedrock Model ID
MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Polly Voice ID
POLLY_VOICE=Joanna

# DynamoDB Table Name (optional for local testing)
DDB_TABLE=Sessions

# S3 Bucket Name (optional for local testing)
BUCKET=vak-artifacts

# Server Configuration
PORT=8080
HOST=0.0.0.0
